#!/usr/bin/env ruby
# frozen_string_literal: true

# Validate media emitted by a clean Jekyll build. This intentionally checks the
# generated site, not only the source tree, so truncated or missing copies are
# detected before deployment.

require "cgi"
require "fileutils"
require "open3"

REPOSITORY_ROOT = File.expand_path("..", __dir__)
SITE_ROOT = File.join(REPOSITORY_ROOT, "_site")
IMAGE_EXTENSIONS = %w[.gif .jpeg .jpg .png .webp].freeze

errors = []
html_files = Dir.glob(File.join(SITE_ROOT, "**", "*.html"))

if html_files.empty?
  errors << "No generated HTML files found under _site."
end

references = html_files.flat_map do |html_file|
  html = File.read(html_file)
  direct_urls = html.scan(/\b(?:poster|src)=["']([^"']+)["']/i).flatten
  srcset_urls = html.scan(/\bsrcset=["']([^"']+)["']/i).flatten.flat_map do |srcset|
    srcset.split(",").map { |candidate| candidate.strip.split(/\s+/, 2).first }
  end
  direct_urls + srcset_urls
end

asset_references = references.filter_map do |url|
  next unless url.start_with?("/assets/")

  CGI.unescape(url.split(/[?#]/, 2).first).delete_prefix("/")
end.uniq.sort

if asset_references.empty?
  errors << "No local media references found in generated HTML."
end

asset_references.each do |relative_path|
  built_path = File.expand_path(relative_path, SITE_ROOT)
  source_path = File.expand_path(relative_path, REPOSITORY_ROOT)

  unless built_path.start_with?("#{SITE_ROOT}#{File::SEPARATOR}")
    errors << "Unsafe generated media path: /#{relative_path}"
    next
  end

  unless File.file?(built_path)
    errors << "Missing generated media: /#{relative_path}"
    next
  end

  if File.zero?(built_path)
    errors << "Empty generated media: /#{relative_path}"
    next
  end

  if File.file?(source_path) && !FileUtils.compare_file(source_path, built_path)
    errors << "Generated copy differs from its asset: /#{relative_path}"
  end

  extension = File.extname(built_path).downcase
  if IMAGE_EXTENSIONS.include?(extension)
    unless system("identify", "-quiet", built_path, out: File::NULL, err: File::NULL)
      errors << "Unreadable generated image: /#{relative_path}"
      next
    end

    portrait_match = relative_path.match(%r{\Aassets/images/people/.+-(300|600)\.webp\z})
    next unless portrait_match

    expected_dimensions = "#{portrait_match[1]}x#{portrait_match[1]}"
    dimensions, status = Open3.capture2(
      "identify", "-format", "%wx%h", built_path
    )
    unless status.success? && dimensions == expected_dimensions
      errors << "Wrong portrait dimensions for /#{relative_path}: " \
                "expected #{expected_dimensions}, got #{dimensions.inspect}"
    end
  elsif extension == ".mp4"
    codec, status = Open3.capture2e(
      "ffprobe", "-v", "error", "-select_streams", "v:0",
      "-show_entries", "stream=codec_name",
      "-of", "default=noprint_wrappers=1:nokey=1", built_path
    )
    unless status.success? && codec.strip == "h264"
      errors << "Invalid or non-H.264 generated video: /#{relative_path}"
    end
  end
end

empty_assets = Dir.glob(File.join(SITE_ROOT, "assets", "**", "*"))
                  .select { |path| File.file?(path) && File.zero?(path) }
empty_assets.each do |path|
  errors << "Empty published asset: #{path.delete_prefix("#{SITE_ROOT}/")}"
end

if File.exist?(File.join(SITE_ROOT, "_media_sources"))
  errors << "_media_sources must not be included in the generated site."
end

if errors.any?
  warn "Site validation failed with #{errors.length} error(s):"
  errors.each { |error| warn "- #{error}" }
  exit 1
end

puts "Validated #{html_files.length} HTML files and " \
     "#{asset_references.length} referenced media assets."
